# Dependencies
node_modules
# Build outputs
dist
build
*.tsbuildinfo

# Expo
.expo/
ios/
android/
web-build/

# Local Expo modules contain hand-written native source, not generated projects.
!apps/native/modules/**/ios/
!apps/native/modules/**/ios/**
!apps/native/modules/**/android/
!apps/native/modules/**/android/**

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.cert
apps/native/credentials.json
apps/native/google-service-account*.json

# Tool-owned worktrees are not source or EAS build input
.claude/worktrees/

# Shared on purpose. A repo .gitignore outranks the global excludes file, so
# this negation is what brings the file back — a plain `git add -f` would
# leave it ignored and hide every later edit.
!.claude/settings.local.json

# Metro
.metro-health-check*

# Environment files
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Turbo
.turbo
.nx

# Better-T-Stack
.alchemy

# Testing
coverage
.nyc_output

# Misc
*.tgz
.cache
tmp
