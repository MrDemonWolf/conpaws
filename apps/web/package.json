{
  "name": "@conpaws/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "build:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "preview": "bun run build:cloudflare && opennextjs-cloudflare preview --ip 127.0.0.1 --port 8789 --persist-to ../../apps/admin/.wrangler/state",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:overflow": "bun scripts/overflow.ts",
    "generate:og": "bun scripts/generate-og.ts"
  },
  "dependencies": {
    "@conpaws/env": "workspace:*",
    "@conpaws/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@conpaws/config": "workspace:*",
    "@conpaws/infra": "workspace:*",
    "@opennextjs/cloudflare": "1.20.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "4.155.0"
  }
}
