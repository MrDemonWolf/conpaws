<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDisplayName</key>
    <string>ConPaws</string>
    <!-- Marks this as a modern single-target watch app. Without it watchOS
         looks for a legacy WKWatchKitApp extension pair and refuses to
         install with "cannot be installed at this time". -->
    <key>WKApplication</key>
    <true/>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <false/>
  </dict>
</plist>
