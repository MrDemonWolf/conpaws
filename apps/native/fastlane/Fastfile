require "fileutils"
require "open3"
require "plist"
require "xcodeproj"

# Fastlane runs lanes from this directory; generated projects live one level up.
APP = File.expand_path("..", __dir__)
OUTPUT = File.join(APP, "build/store")
TEAM = "HBB7T99U79"
BUNDLE = "com.mrdemonwolf.conpaws"

before_all do
  UI.user_error!("Native release only accepts dev or main") unless %w[dev main].include?(ENV["RELEASE_BRANCH"])
  expected = ENV["RELEASE_BRANCH"] == "dev" ? "preview" : "production"
  UI.user_error!("Wrong app variant for release branch") unless ENV["APP_VARIANT"] == expected
end

platform :ios do
  lane :release do
    setup_ci(timeout: 0)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_BASE64"),
      is_key_content_base64: true
    )
    signing = ENV.fetch("IOS_SIGNING_DIRECTORY")
    import_certificate(
      certificate_path: File.join(signing, "distribution.p12"),
      certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
    )

    profiles = {}
    Dir[File.join(signing, "*.mobileprovision")].each do |file|
      xml, status = Open3.capture2("/usr/bin/security", "cms", "-D", "-i", file)
      UI.user_error!("Cannot decode provisioning profile") unless status.success?
      profile = Plist.parse_xml(xml)
      id = profile.fetch("Entitlements").fetch("application-identifier").delete_prefix("#{TEAM}.")
      UI.user_error!("Wrong team or expired/non-store provisioning profile") unless
        profile.fetch("TeamIdentifier").include?(TEAM) && profile.fetch("ExpirationDate").to_time > Time.now &&
        !profile.key?("ProvisionedDevices") && !profile["ProvisionsAllDevices"] &&
        !profile.fetch("Entitlements")["get-task-allow"]
      UI.user_error!("Duplicate provisioning profile for #{id}") if profiles.key?(id)
      install_provisioning_profile(path: file)
      profiles[id] = profile.fetch("UUID")
    end

    project_path = File.join(APP, "ios/ConPaws.xcodeproj")
    project = Xcodeproj::Project.open(project_path)
    required = [BUNDLE, "#{BUNDLE}.widgets", "#{BUNDLE}.watchkitapp", "#{BUNDLE}.watchkitapp.widgets"]
    configured = []
    project.targets.each do |target|
      configuration = target.build_configurations.find { |item| item.name == "Release" }
      id = configuration&.build_settings&.fetch("PRODUCT_BUNDLE_IDENTIFIER", nil)
      next unless required.include?(id)
      UI.user_error!("Missing App Store profile for #{id}") unless profiles.key?(id)
      update_code_signing_settings(
        path: project_path, targets: [target.name], build_configurations: ["Release"],
        use_automatic_signing: false, team_id: TEAM,
        code_sign_identity: "Apple Distribution", profile_uuid: profiles.fetch(id)
      )
      configured << id
    end
    UI.user_error!("Prebuild is missing a ConPaws Widget or Watch target") unless required.sort == configured.sort
    ipa = build_app(
      workspace: File.join(APP, "ios/ConPaws.xcworkspace"), scheme: "ConPaws",
      configuration: "Release", export_method: "app-store",
      export_options: {
        signingStyle: "manual", provisioningProfiles: profiles, teamID: TEAM,
        testFlightInternalTestingOnly: ENV["RELEASE_BRANCH"] == "dev"
      },
      output_directory: OUTPUT, output_name: "ConPaws.ipa"
    )
    upload_to_testflight(
      api_key: api_key, ipa: ipa, app_identifier: BUNDLE,
      distribute_external: false, skip_waiting_for_build_processing: true,
      changelog: "#{ENV.fetch('RELEASE_BRANCH')} · #{ENV.fetch('RELEASE_SHA')}"
    )
  end
end

platform :android do
  lane :release do
    gradle(
      task: "bundle", build_type: "Release", project_dir: File.join(APP, "android"),
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV.fetch("ANDROID_KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("ANDROID_STORE_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD")
      }
    )
    FileUtils.mkdir_p(OUTPUT)
    aab = File.join(OUTPUT, "ConPaws.aab")
    FileUtils.cp(File.join(APP, "android/app/build/outputs/bundle/release/app-release.aab"), aab)
    upload_to_play_store(
      package_name: BUNDLE, json_key: ENV.fetch("GOOGLE_PLAY_KEY_PATH"), aab: aab,
      track: ENV["RELEASE_BRANCH"] == "dev" ? "internal" : "production",
      release_status: ENV["RELEASE_BRANCH"] == "dev" ? "completed" : "draft",
      skip_upload_metadata: true, skip_upload_images: true,
      skip_upload_screenshots: true, skip_upload_changelogs: true
    )
  end
end
