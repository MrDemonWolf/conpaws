APP_VARIANT=development

# API server (Cloudflare Worker) — validated by packages/env/src/native.ts
EXPO_PUBLIC_SERVER_URL=

# RevenueCat (in-app purchases) — optional, premium features disabled without these
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# Sentry (store SENTRY_AUTH_TOKEN as a Sensitive EAS variable; never commit it)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
