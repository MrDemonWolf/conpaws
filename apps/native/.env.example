APP_VARIANT=development

# Sentry (store SENTRY_AUTH_TOKEN as a Sensitive EAS variable; never commit it)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Public API base. Leave empty for https://api.conpaws.com. Point the app at a
# local `bun dev:api` server with http://127.0.0.1:8790 (iOS simulator) or
# http://10.0.2.2:8790 (Android emulator).
EXPO_PUBLIC_CONPAWS_API_URL=

# Planned, not read by any code yet: no RevenueCat package is installed.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
