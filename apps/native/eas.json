{
  "cli": {
    "version": ">= 22.0.0 < 23.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "bun": "1.3.10",
      "node": "22.13.1",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "bun": "1.3.10",
      "node": "22.13.1",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "preview-device": {
      "distribution": "internal",
      "environment": "preview",
      "bun": "1.3.10",
      "node": "22.13.1",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "bun": "1.3.10",
      "node": "22.13.1",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleTeamId": "HBB7T99U79"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "HBB7T99U79"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
