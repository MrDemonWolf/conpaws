{
  "name": "@conpaws/native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client --scheme conpaws-dev",
    "start": "APP_VARIANT=development expo start --dev-client --scheme conpaws-dev",
    "start:preview": "APP_VARIANT=preview expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "android": "expo run:android",
    "ios": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios --device \"ConPaws iPhone Pro Max\"",
    "web": "expo start --web",
    "check-types": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses:generate": "node scripts/generate-open-source-licenses.mjs",
    "licenses:check": "node scripts/generate-open-source-licenses.mjs --check",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build-number:bump": "node scripts/build-number.mjs --bump",
    "build-number:check": "node scripts/build-number.mjs --check",
    "ship:prep": "node scripts/build-number.mjs --bump && expo prebuild && node scripts/build-number.mjs --check"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.14",
    "@formatjs/intl-datetimeformat": "^7.6.0",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@formatjs/intl-supportedvaluesof": "2.3.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.3",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "i18next": "^25.8.7",
    "lucide-react-native": "^0.564.0",
    "nativewind": "5.0.0-preview.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.4",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.5",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.8",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
