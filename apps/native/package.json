{
  "name": "@conpaws/native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client --scheme conpaws-dev",
    "start": "APP_VARIANT=development expo start --dev-client --scheme conpaws-dev",
    "start:preview": "APP_VARIANT=preview expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "android": "expo run:android",
    "ios": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "web": "expo start --web",
    "check-types": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "licenses:generate": "node scripts/generate-open-source-licenses.mjs",
    "licenses:check": "node scripts/generate-open-source-licenses.mjs --check",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build-number:bump": "node scripts/build-number.mjs --bump",
    "build-number:check": "node scripts/build-number.mjs --check",
    "ship:prep": "bun run licenses:check && node scripts/build-number.mjs --bump && expo prebuild && node scripts/build-number.mjs --check"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.25",
    "@formatjs/intl-datetimeformat": "^7.8.2",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@formatjs/intl-supportedvaluesof": "2.3.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.5.11",
    "lucide-react-native": "^1.64.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.32",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
