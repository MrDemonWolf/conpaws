# Local development only. Copy this to .dev.vars (ignored by git).
ADMIN_RUNTIME_ENV=local

# Optional shortcut: act as this address without signing in. On a local
# catalog with no owner yet it becomes the owner. Remove it to try the real
# email-code sign-in; locally each code is printed in the dev server log.
ADMIN_DEV_EMAIL=owner@local.conpaws.test
