{
  "extends": "@conpaws/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@conpaws/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./.next/types/**/*.ts"],
  "exclude": ["./node_modules"]
}
