{
  "name": "@conpaws/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3003",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bun scripts/e2e.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "bun run build:cloudflare && opennextjs-cloudflare preview --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply CATALOG_DB --local --persist-to .wrangler/state",
    "db:seed:local": "bun scripts/seed-local.mjs",
    "invite": "bun scripts/invite.mjs"
  },
  "dependencies": {
    "@conpaws/ui": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@opennextjs/cloudflare": "1.20.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
