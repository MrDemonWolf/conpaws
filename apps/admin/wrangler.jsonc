{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local `next dev` and OpenNext preview only. Production bindings come from
  // packages/infra/alchemy.run.ts; keep the names here in step with it.
  "name": "conpaws-admin-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "conpaws-admin-local"
    }
  ],
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "conpaws-admin-preview-local-v2",
      "database_id": "conpaws-admin-preview-local-v2",
      "migrations_table": "drizzle_migrations",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "ADMIN_EMAIL_FROM": "admin@conpaws.com"
  },
  // Local email is not delivered; the local runtime also prints each sign-in
  // code in the dev server log.
  "send_email": [
    {
      "name": "ADMIN_EMAIL",
      "allowed_sender_addresses": ["admin@conpaws.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "ADMIN_SIGN_IN_LIMITER",
      "namespace_id": "2610",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
