{
  "$schema": "node_modules/wrangler/config-schema.json",

  // LOCAL DEVELOPMENT ONLY.
  //
  // Production deployment is owned by packages/infra/alchemy.run.ts, which
  // uploads this Worker as `conpaws-api`, binds the admin-owned catalog D1 and
  // the cdn.conpaws.com bucket, and attaches api.conpaws.com. This file exists
  // so `bun run --filter @conpaws/api dev` serves the same routes on a laptop
  // against the admin app's local catalog state. Never put a real
  // `database_id` here.

  "name": "conpaws-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  // MUST equal COMPATIBILITY_DATE in packages/infra/alchemy.run.ts.
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      // The admin app's local catalog database, shared through --persist-to.
      "binding": "CATALOG_DB",
      "database_name": "conpaws-admin-preview-local-v2",
      "database_id": "conpaws-admin-preview-local-v2"
    }
  ],

  "r2_buckets": [
    {
      "binding": "CDN_BUCKET",
      "bucket_name": "conpaws-cdn-local"
    }
  ],

  // Mirrors packages/infra/alchemy.run.ts. Workers Cache is what makes the
  // catalog's s-maxage real on Cloudflare's network; limits are inert locally.
  "cache": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 200
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
