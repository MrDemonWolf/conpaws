{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.codex",
      "!**/.claude",
      "!**/.next",
      "!**/.open-next",
      "!**/.expo",
      "!**/android",
      "!**/ios",
      "!**/dist",
      "!**/drizzle",
      "!**/*.d.ts",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/native/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": {
                "skip": ["Button", "ListItem", "NativeText"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["AGENTS.md"],
      "formatter": { "enabled": false }
    }
  ]
}
