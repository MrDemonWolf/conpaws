# NOTE: .env files are local-development-only. EAS builds read EAS Environment
# Variables (`eas env:pull`); Cloudflare Workers read wrangler.jsonc bindings
# and `wrangler secret`.

# ---------------------------------------------------------------------------
# apps/native
# ---------------------------------------------------------------------------

# API server (Cloudflare Worker). Not validated at runtime: nothing in
# apps/native reads it yet.
EXPO_PUBLIC_SERVER_URL=http://localhost:8787

# RevenueCat (in-app purchases). Planned, not read by any code yet: no
# RevenueCat package is installed and the Worker does not exist.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your-apple-api-key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=your-google-api-key

# Crash reporting. Only initialised in preview and production builds, and only
# when the DSN parses as a real Sentry URL (see src/lib/sentry-config.ts).
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# apps/web
#
# Which file these belong in depends on how the Worker is being run, and the
# three are NOT interchangeable:
#
#   opennextjs-cloudflare preview / wrangler dev  ->  apps/web/.dev.vars
#   `bun run deploy` (Alchemy) from the repo root ->  apps/web/.env and
#                                                     packages/infra/.env
#   GitHub Actions production deploy              ->  repo secrets/variables
#
# Putting them only in .dev.vars and then running `bun run deploy` yields
# unresolved Config values rather than a useful error.
# ---------------------------------------------------------------------------

# Build-time client variable, so it must be present wherever the OpenNext build
# runs. Without it the widget never renders and the form closes itself rather
# than posting an empty token that the route would reject on every attempt.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-side. Read per-request from Worker bindings, never from process.env,
# which is why packages/env/src/web.ts deliberately omits them. All five are
# required together — a partial set fails closed with a 503 rather than
# half-opening the waitlist.
TURNSTILE_SECRET_KEY=
LISTMONK_BASE_URL=https://lists.mrdemonwolf.com
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# 3 is the private double opt-in "ConPaws Waitlist" list.
LISTMONK_LIST_ID=3

# ---------------------------------------------------------------------------
# packages/infra
# ---------------------------------------------------------------------------

# Encrypts Alchemy state.
ALCHEMY_PASSWORD=
