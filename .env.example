# NOTE: .env files are local-development-only. EAS builds read EAS Environment
# Variables (`eas env:pull`); Cloudflare Workers read wrangler.jsonc bindings.

# API server (Cloudflare Worker). Not validated at runtime yet — a schema
# exists at packages/env/src/native.ts but nothing imports it.
EXPO_PUBLIC_SERVER_URL=http://localhost:8787

# RevenueCat (in-app purchases) — optional, premium features disabled without these
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your-apple-api-key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=your-google-api-key
