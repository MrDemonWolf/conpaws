{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-worker-preview",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "opennextjs-cloudflare",
        "preview",
        "--",
        "--port",
        "8787"
      ],
      "cwd": "apps/web",
      "port": 8787
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "start", "--", "--port", "3100"],
      "cwd": "apps/web",
      "port": 3100
    }
  ]
}
