{
  "name": "conpaws",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.10",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "start": "turbo -F native start",
    "start:preview": "turbo -F native start:preview",
    "start:prod": "turbo -F native start:prod",
    "android": "turbo -F native android",
    "ios": "turbo -F native ios",
    "web": "turbo -F native web",
    "prebuild": "turbo -F native prebuild",
    "prebuild:clean": "turbo -F native prebuild:clean",
    "type-check": "turbo -F native type-check"
  },
  "dependencies": {
    "@conpaws/env": "workspace:*",
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@conpaws/config": "workspace:*",
    "turbo": "^2.8.12",
    "typescript": "^5"
  }
}
