# Values from the Dokploy PostgreSQL service for Listmonk. Copy them exactly as
# Dokploy prints them; do not guess the internal hostname.
DB_HOST=replace-with-dokploy-internal-postgres-host
DB_PORT=5432
DB_USER=listmonk
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=listmonk

# "disable" is only valid while Postgres is a private service on the same host.
# An external database must use "require" or stricter.
DB_SSL_MODE=disable

# Bootstrap inputs that seed the first super admin. Remove both from Dokploy
# once the account exists and its password is stored in the password manager.
ADMIN_USER=replace-with-owner-username
ADMIN_PASSWORD=REPLACE_WITH_PASSWORD_MANAGER_VALUE

# NOT SET HERE, ON PURPOSE:
#
# SMTP credentials, the sending domain, and bounce settings live in Listmonk's
# own Settings UI and are stored in Postgres, not in the environment. The SES
# SMTP username and password are generated in SES -> SMTP settings; they are a
# distinct credential pair derived for the SMTP endpoint and are NOT an IAM
# access key ID and secret. Pasting IAM keys into the SMTP fields fails to
# authenticate.
