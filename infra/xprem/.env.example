# Public URL served through the existing Cloudflare Tunnel. Do not add a trailing slash.
BASE_URL=https://updates.mrdemonwolf.com

# Required: set only after verifying the real X-Forwarded-For proxy chain.
# A tunnel connected directly to xprem is normally 1; verify before setting it.
TRUST_PROXY_DEPTH=

# Paste the exact private connection URL issued by the Dokploy PostgreSQL service.
# Do not guess its host or TLS mode.
DB_URL=REPLACE_WITH_EXACT_DOKPLOY_INTERNAL_DATABASE_URL

# Generate once. Prefer an existing Dokploy Secrets Provider; otherwise use
# service-scoped Compose variables and restrict project access.
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_KEYS_MASTER_KEY_B64=replace-with-32-random-bytes-encoded-as-base64

# Private Cloudflare R2 bucket shared by MrDemonWolf product OTA assets.
# Use an account-owned Object Read & Write token scoped only to this bucket
# (Workers R2 Storage Bucket Item Write).
# Database and immutable asset backups use a separate bucket and credentials,
# such as mrdemonwolf-ota-backups. Those credentials are not used by xprem.
AWS_REGION=auto
AWS_BASE_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=mrdemonwolf-ota-assets
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Bootstrap inputs that seed the first administrator. Remove both from Dokploy after
# the seeded administrator is secured and verified, and remove their two
# environment entries from the live Compose definition. ADMIN_PASSWORD must
# have 8+ characters with uppercase, lowercase, digit, and special characters.
ADMIN_EMAIL=replace-with-owner-email
ADMIN_PASSWORD=REPLACE_WITH_PASSWORD_MANAGER_VALUE
